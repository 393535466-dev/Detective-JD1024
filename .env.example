DASHSCOPE_API_KEY=
# 从百炼控制台复制与你的地域/业务空间匹配的 OpenAI 兼容地址，末尾到 /v1。
VISION_BASE_URL=
VISION_MODEL=qwen3-vl-plus
SERPAPI_KEY=
# 可选：高德 Web 服务 Key，补充公共地点地址及可用照片。
AMAP_KEY=
# 公网部署时设置长随机令牌；前端填写同一令牌，Dify 用 Bearer 认证。
PICTRACE_API_TOKEN=
MAX_IMAGE_PIXELS=16000000
REQUEST_TIMEOUT_SECONDS=150
PORT=8000
# 使用 GitHub Pages 前端时填写其 origin（没有仓库路径）。
CORS_ALLOWED_ORIGINS=https://393535466-dev.github.io
